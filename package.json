{
  "name": "@x-mesh/ai-spinner",
  "version": "0.1.0",
  "description": "68 canvas spinner styles, each with nine states, for showing what an AI is doing while it thinks.",
  "keywords": [
    "spinner",
    "loader",
    "loading",
    "ai",
    "react",
    "canvas",
    "animation",
    "thinking"
  ],
  "license": "MIT",
  "homepage": "https://x-mesh.github.io/ai-spinner/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-mesh/ai-spinner.git"
  },
  "bugs": {
    "url": "https://github.com/x-mesh/ai-spinner/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js"
    },
    "./sets": {
      "types": "./dist/sets/index.d.ts",
      "import": "./dist/sets/index.js"
    },
    "./sets/*": {
      "types": "./dist/sets/*.d.ts",
      "import": "./dist/sets/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepublishOnly": "npm run lint && tsc -b && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
